    private void renderCalendar(){
        LinearLayout c=card();page.addView(c);LinearLayout h=new LinearLayout(this);h.setGravity(Gravity.CENTER_VERTICAL);Button p=button("‹",false),n=button("›",false);TextView t=text(monthName(calendarCursor),18,WHITE,true);t.setGravity(Gravity.CENTER);h.addView(p,new LinearLayout.LayoutParams(dp(48),dp(44)));h.addView(t,new LinearLayout.LayoutParams(0,dp(44),1));h.addView(n,new LinearLayout.LayoutParams(dp(48),dp(44)));c.addView(h);p.setOnClickListener(v->{calendarCursor.add(Calendar.MONTH,-1);showTab("Calendario");});n.setOnClickListener(v->{calendarCursor.add(Calendar.MONTH,1);showTab("Calendario");});
        LinearLayout legend=new LinearLayout(this);legend.setPadding(0,dp(8),0,dp(8));legend.addView(text("● verde vacaciones   ● dorado festivo   ● rojo baja",11,MUTED,false));c.addView(legend);
        GridLayout grid=new GridLayout(this);grid.setColumnCount(7);String[] ds={"L","M","X","J","V","S","D"};for(String d:ds){TextView x=text(d,11,MUTED,true);x.setGravity(Gravity.CENTER);grid.addView(x,new GridLayout.LayoutParams(spec(),spec1()));}
        Calendar a=(Calendar)calendarCursor.clone();a.set(Calendar.DAY_OF_MONTH,1);Calendar z=(Calendar)a.clone();z.set(Calendar.DAY_OF_MONTH,z.getActualMaximum(Calendar.DAY_OF_MONTH));int first=(a.get(Calendar.DAY_OF_WEEK)+5)%7;for(int i=0;i<first;i++)grid.addView(new Space(this),new GridLayout.LayoutParams(spec(),spec1()));Map<String,JSONObject> data=new HashMap<>();c.addView(grid,new LinearLayout.LayoutParams(-1,-2));
        JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_start_date",iso(a));b.put("p_end_date",iso(z));b.put("p_employee_id",JSONObject.NULL);}catch(Exception ignored){}rpc("app_get_entries",b,r->{JSONArray es=r.optJSONArray("entries");if(es!=null)for(int i=0;i<es.length();i++){JSONObject e=es.optJSONObject(i);data.put(e.optString("date"),e);}fillCalendar(grid,a,z,first,data);});
    }
    private GridLayout.Spec spec(){return GridLayout.spec(GridLayout.UNDEFINED);} private GridLayout.Spec spec1(){return GridLayout.spec(GridLayout.UNDEFINED,1f);}
    private void fillCalendar(GridLayout grid,Calendar a,Calendar z,int first,Map<String,JSONObject> data){while(grid.getChildCount()>7+first)grid.removeViewAt(grid.getChildCount()-1);for(int day=1;day<=z.get(Calendar.DAY_OF_MONTH);day++){Calendar d=(Calendar)a.clone();d.set(Calendar.DAY_OF_MONTH,day);JSONObject e=data.get(iso(d));TextView cell=text(String.valueOf(day),13,WHITE,true);cell.setGravity(Gravity.CENTER);cell.setPadding(dp(2),dp(9),dp(2),dp(9));int col=Color.rgb(18,18,18);if(e!=null){String inc=e.optString("incident","");if(inc.equals("vacation"))col=Color.rgb(25,70,30);else if(inc.equals("sick_leave"))col=Color.rgb(75,25,25);else if(e.optDouble("holiday")>0)col=Color.rgb(92,76,20);}cell.setBackground(bg(col,8,Color.rgb(35,35,35)));GridLayout.LayoutParams lp=new GridLayout.LayoutParams(spec(),spec1());lp.width=0;lp.setMargins(dp(2),dp(2),dp(2),dp(2));grid.addView(cell,lp);}}

    private void renderFichajes(){
        LinearLayout info=card();page.addView(info);info.addView(text("FICHAJES",20,WHITE,true));info.addView(text("Revisa y firma tus hojas mensuales. No se vuelve a pedir el PIN: la confirmación queda vinculada a tu sesión.",13,MUTED,false));
        LinearLayout list=new LinearLayout(this);list.setOrientation(LinearLayout.VERTICAL);page.addView(list);list.addView(text("Cargando fichajes…",13,MUTED,false));
        JSONObject b=new JSONObject();try{b.put("p_session_token",token);}catch(Exception ignored){}edge("months",b,r->{list.removeAllViews();if(!r.optBoolean("ok")){list.addView(text(r.optString("error","No se pudieron cargar"),14,RED,false));return;}JSONArray ms=r.optJSONArray("months");if(ms==null||ms.length()==0){list.addView(text("No hay hojas mensuales",14,MUTED,false));return;}for(int i=0;i<ms.length();i++){JSONObject m=ms.optJSONObject(i);LinearLayout c=card();list.addView(c);LinearLayout top=new LinearLayout(this);top.setGravity(Gravity.CENTER_VERTICAL);LinearLayout words=new LinearLayout(this);words.setOrientation(LinearLayout.VERTICAL);String month=m.optString("month","");words.addView(text(monthLabel(month),16,WHITE,true));String meta=m.optInt("workdays")+" jornadas · "+cleanNum(m.optInt("effective_minutes")/60.0)+" h"+(m.optBoolean("reconstructed")?" · histórico reconstruido":"");words.addView(text(meta,11,MUTED,false));top.addView(words,new LinearLayout.LayoutParams(0,-2,1));boolean signed=m.optBoolean("signed"),review=m.optBoolean("needs_review"),can=m.optBoolean("can_confirm");TextView st=text(signed?"Firmado ✓":review?"Requiere revisión":can?"Pendiente":"En curso",11,signed?GREEN:review?RED:can?YELLOW:MUTED,true);st.setPadding(dp(8),dp(5),dp(8),dp(5));top.addView(st);c.addView(top);c.setOnClickListener(v->openFichajeMonth(m));}});
    }
    private String monthLabel(String ym){try{Date d=new SimpleDateFormat("yyyy-MM",Locale.US).parse(ym);return new SimpleDateFormat("MMMM yyyy",new Locale("es","ES")).format(d);}catch(Exception e){return ym;}}
    private void openFichajeMonth(JSONObject m){
        page.removeAllViews();LinearLayout head=card();page.addView(head);Button back=button("‹ VOLVER",false);head.addView(back,new LinearLayout.LayoutParams(-1,dp(46)));head.addView(text(monthLabel(m.optString("month")),20,WHITE,true));if(m.optBoolean("reconstructed"))head.addView(text("Histórico reconstruido posteriormente. Revisa los días antes de confirmar.",12,MUTED,false));if(m.optBoolean("needs_review"))head.addView(text("Este mes contiene días que requieren revisión antes de firmar.",12,RED,true));back.setOnClickListener(v->showTab("Fichajes"));
        LinearLayout days=card();page.addView(days);days.addView(text("Cargando hoja…",13,MUTED,false));JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_start_date",m.optString("period_start"));b.put("p_end_date",m.optString("period_end"));}catch(Exception ignored){}edge("records",b,r->{days.removeAllViews();if(!r.optBoolean("ok")){days.addView(text(r.optString("error","No se pudo cargar"),14,RED,false));return;}JSONArray es=r.optJSONArray("entries");if(es!=null)for(int i=0;i<es.length();i++){JSONObject e=es.optJSONObject(i);LinearLayout row=new LinearLayout(this);row.setOrientation(LinearLayout.VERTICAL);row.setPadding(0,dp(10),0,dp(10));LinearLayout top=new LinearLayout(this);TextView d=text(humanDate(e.optString("date")),13,WHITE,true);top.addView(d,new LinearLayout.LayoutParams(0,-2,1));String kind=e.optString("day_kind");String badge=kind.equals("workday")?"8 h":kind.equals("vacation")?"Vacaciones":kind.equals("sick_leave")?"Baja / IT":kind.equals("holiday")?"Festivo":"Ausencia";top.addView(text(badge,12,MUTED,true));row.addView(top);if(kind.equals("workday"))row.addView(text("08:00–14:00 · 15:00–17:00",12,MUTED,false));if(e.optBoolean("needs_review"))row.addView(text("⚠ Requiere revisión",11,RED,true));days.addView(row);View sep=new View(this);sep.setBackgroundColor(Color.rgb(34,34,34));days.addView(sep,new LinearLayout.LayoutParams(-1,dp(1)));}
            JSONObject conf=r.optJSONObject("confirmation");boolean valid=conf!=null&&conf.optBoolean("valid");LinearLayout sign=card();page.addView(sign);sign.addView(text("Confirmación del trabajador",17,WHITE,true));sign.addView(text("Confirmo que he revisado esta hoja mensual y que, según mi conocimiento, refleja la jornada realizada.",12,MUTED,false));Button sb=button(valid?"FIRMADO ✓":r.optBoolean("can_confirm")?"FIRMAR REGISTRO DEL MES":r.optBoolean("needs_review")?"REQUIERE REVISIÓN":"DISPONIBLE AL FINALIZAR",true);sb.setEnabled(!valid&&r.optBoolean("can_confirm"));LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,dp(52));lp.setMargins(0,dp(12),0,0);sign.addView(sb,lp);if(valid)sign.addView(text("Confirmado el "+conf.optString("confirmed_at"),11,GREEN,false));sb.setOnClickListener(v->new AlertDialog.Builder(this).setTitle("Firmar registro").setMessage("¿Confirmas que has revisado esta hoja mensual y que refleja tu jornada?").setNegativeButton("Cancelar",null).setPositiveButton("Confirmar",(d,w)->confirmFichaje(m,sb)).show());});
    }
    private void confirmFichaje(JSONObject m,Button b){JSONObject x=new JSONObject();try{x.put("p_session_token",token);x.put("p_start_date",m.optString("period_start"));x.put("p_end_date",m.optString("period_end"));}catch(Exception ignored){}b.setEnabled(false);edge("confirm",x,r->{if(r.optBoolean("ok")){toast("Registro firmado correctamente");showTab("Fichajes");}else{b.setEnabled(true);toast(r.optString("error","No se pudo firmar"));}});}

    private void renderSummary(){
        int y=Calendar.getInstance().get(Calendar.YEAR);LinearLayout c=card();page.addView(c);c.addView(text("RESUMEN",20,WHITE,true));c.addView(text("Año "+y,13,MUTED,false));LinearLayout stats=new LinearLayout(this);stats.setOrientation(LinearLayout.VERTICAL);c.addView(stats);stats.addView(text("Calculando resumen…",13,MUTED,false));JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_start_date",y+"-01-01");b.put("p_end_date",y+"-12-31");b.put("p_employee_id",JSONObject.NULL);}catch(Exception ignored){}rpc("app_get_entries",b,r->{stats.removeAllViews();JSONArray es=r.optJSONArray("entries");double n=0,e=0,h=0,p=0;int vac=0,sick=0;if(es!=null)for(int i=0;i<es.length();i++){JSONObject x=es.optJSONObject(i);n+=x.optDouble("normal");e+=x.optDouble("extra");h+=x.optDouble("holiday");p+=x.optDouble("personal");if("vacation".equals(x.optString("incident")))vac++;if("sick_leave".equals(x.optString("incident")))sick++;}double av=me.optDouble("annual_vacation_days",30),ap=me.optDouble("annual_personal_hours",12);stats.addView(stat("Vacaciones usadas",vac+" d","Quedan "+cleanNum(av-vac)+" d"));stats.addView(stat("Horas personales",cleanNum(p)+" h","Quedan "+cleanNum(ap-p)+" h"));stats.addView(stat("Horas normales",cleanNum(n)+" h",null));stats.addView(stat("Horas extra",cleanNum(e)+" h",null));stats.addView(stat("Horas festivas",cleanNum(h)+" h",null));stats.addView(stat("Baja / IT",sick+" d",null));});
    }
    private LinearLayout stat(String label,String value,String sub){LinearLayout x=new LinearLayout(this);x.setOrientation(LinearLayout.VERTICAL);x.setPadding(dp(12),dp(11),dp(12),dp(11));x.setBackground(bg(Color.rgb(9,9,9),12,Color.rgb(35,35,35)));LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,-2);lp.setMargins(0,dp(8),0,0);x.setLayoutParams(lp);x.addView(text(label,12,MUTED,false));x.addView(text(value,20,GREEN,true));if(sub!=null)x.addView(text(sub,11,MUTED,false));return x;}

    private void renderProfile(){
        LinearLayout c=card();page.addView(c);c.addView(text("MI PERFIL",20,WHITE,true));c.addView(text(me.optString("full_name",""),17,WHITE,true));c.addView(text("Usuario: "+me.optString("username",""),12,MUTED,false));c.addView(text("Vacaciones anuales: "+cleanNum(me.optDouble("annual_vacation_days",30)),13,WHITE,false));c.addView(text("Horas personales: "+cleanNum(me.optDouble("annual_personal_hours",12)),13,WHITE,false));
        Button pin=button("CAMBIAR MI PIN",false);LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,dp(50));lp.setMargins(0,dp(14),0,0);c.addView(pin,lp);pin.setOnClickListener(v->changePinDialog());Button logout=button("CERRAR SESIÓN",false);c.addView(logout,new LinearLayout.LayoutParams(-1,dp(50)));logout.setOnClickListener(v->confirmLogout());
    }
    private void changePinDialog(){LinearLayout p=new LinearLayout(this);p.setOrientation(LinearLayout.VERTICAL);p.setPadding(dp(20),0,dp(20),0);EditText o=field("PIN actual"),n=field("Nuevo PIN de 6 cifras");o.setInputType(InputType.TYPE_CLASS_NUMBER|InputType.TYPE_NUMBER_VARIATION_PASSWORD);n.setInputType(InputType.TYPE_CLASS_NUMBER|InputType.TYPE_NUMBER_VARIATION_PASSWORD);p.addView(o);p.addView(n);new AlertDialog.Builder(this).setTitle("Cambiar PIN").setView(p).setNegativeButton("Cancelar",null).setPositiveButton("Guardar",(d,w)->{if(o.length()!=6||n.length()!=6){toast("Ambos PIN deben tener 6 cifras");return;}JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_current_pin",o.getText().toString());b.put("p_new_pin",n.getText().toString());}catch(Exception ignored){}rpc("change_pin",b,r->toast(r.optBoolean("ok")?"PIN actualizado":r.optString("error","No se pudo cambiar")));}).show();}
    private void confirmLogout(){new AlertDialog.Builder(this).setTitle("Cerrar sesión").setMessage("¿Quieres cerrar la sesión?").setNegativeButton("Cancelar",null).setPositiveButton("Cerrar sesión",(d,w)->{JSONObject b=new JSONObject();try{b.put("p_session_token",token);}catch(Exception ignored){}rpc("logout_app",b,r->{prefs.edit().clear().apply();token="";me=null;showLogin();});}).show();}

