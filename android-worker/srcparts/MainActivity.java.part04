        bottomNav=new LinearLayout(this);bottomNav.setOrientation(LinearLayout.HORIZONTAL);bottomNav.setPadding(dp(5),dp(5),dp(5),dp(5));hs.addView(bottomNav,new HorizontalScrollView.LayoutParams(-1,-1));
        String[] tabs={"Hoy","Mes","Calendario","Fichajes","Resumen","Perfil"}; for(String t:tabs)addNav(t);
        if("admin".equalsIgnoreCase(me.optString("role"))) addNav("Empresa");
        shell.addView(hs,new LinearLayout.LayoutParams(-1,dp(66)));
    }
    private void addNav(String name){
        Button b=new Button(this);b.setText(name.toUpperCase(new Locale("es","ES")));b.setTextSize(10);b.setAllCaps(false);b.setTextColor(MUTED);b.setBackgroundColor(Color.TRANSPARENT);b.setPadding(dp(10),0,dp(10),0);b.setMinWidth(dp(74));b.setOnClickListener(v->showTab(name));bottomNav.addView(b,new LinearLayout.LayoutParams(-2,-1));navButtons.put(name,b);
    }
    private void showTab(String name){ for(Map.Entry<String,Button>e:navButtons.entrySet()){boolean on=e.getKey().equals(name);e.getValue().setTextColor(on?GREEN:MUTED);e.getValue().setTypeface(Typeface.DEFAULT,on?Typeface.BOLD:Typeface.NORMAL);}page.removeAllViews();switch(name){case"Hoy":renderToday();break;case"Mes":renderMonth();break;case"Calendario":renderCalendar();break;case"Fichajes":renderFichajes();break;case"Resumen":renderSummary();break;case"Perfil":renderProfile();break;case"Empresa":renderCompany();break;}}

    private void renderToday(){
        Calendar now=Calendar.getInstance(); LinearLayout c=card();page.addView(c);c.addView(text("HOY",20,WHITE,true));c.addView(text(new SimpleDateFormat("EEEE, d 'de' MMMM",new Locale("es","ES")).format(now.getTime()),13,MUTED,false));
        EditText normal=numberField("0"),extra=numberField("0"),fest=numberField("0"),personal=numberField("0");
        LinearLayout r1=new LinearLayout(this);r1.setOrientation(LinearLayout.HORIZONTAL);c.addView(r1);r1.addView(hourBox("NORMAL",normal),new LinearLayout.LayoutParams(0,-2,1));r1.addView(hourBox("EXTRA",extra),new LinearLayout.LayoutParams(0,-2,1));
        LinearLayout r2=new LinearLayout(this);r2.setOrientation(LinearLayout.HORIZONTAL);c.addView(r2);r2.addView(hourBox("FESTIVO",fest),new LinearLayout.LayoutParams(0,-2,1));r2.addView(hourBox("PERSONAL",personal),new LinearLayout.LayoutParams(0,-2,1));
        addLabel(c,"INCIDENCIA");Spinner incident=new Spinner(this);String[] inc={"Ninguna","Vacaciones","Baja / IT","Ausencia","Personal"};ArrayAdapter<String> ia=new ArrayAdapter<String>(this,android.R.layout.simple_spinner_dropdown_item,inc){@Override public View getView(int p,View v,android.view.ViewGroup g){View x=super.getView(p,v,g);((TextView)x).setTextColor(WHITE);x.setBackgroundColor(Color.rgb(9,9,9));return x;}};incident.setAdapter(ia);c.addView(incident,new LinearLayout.LayoutParams(-1,dp(50)));
        addLabel(c,"OBRA");EditText worksite=field("Código o nombre de obra");c.addView(worksite);
        addLabel(c,"OBSERVACIONES");EditText notes=field("Observaciones");notes.setSingleLine(false);notes.setMinLines(2);c.addView(notes);
        Button save=button("GUARDAR Y SINCRONIZAR",true);LinearLayout.LayoutParams slp=new LinearLayout.LayoutParams(-1,dp(54));slp.setMargins(0,dp(15),0,0);c.addView(save,slp);
        JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_start_date",today());b.put("p_end_date",today());b.put("p_employee_id",JSONObject.NULL);}catch(Exception ignored){}
        rpc("app_get_entries",b,r->{JSONArray a=r.optJSONArray("entries");if(a!=null&&a.length()>0){JSONObject e=a.optJSONObject(0);normal.setText(cleanNum(e.optDouble("normal",0)));extra.setText(cleanNum(e.optDouble("extra",0)));fest.setText(cleanNum(e.optDouble("holiday",0)));personal.setText(cleanNum(e.optDouble("personal",0)));worksite.setText(e.optString("worksite",""));notes.setText(e.optString("notes",""));String ii=e.optString("incident","");int pos=ii.equals("vacation")?1:ii.equals("sick_leave")?2:ii.equals("absence")?3:ii.equals("personal")?4:0;incident.setSelection(pos);}});
        save.setOnClickListener(v->{String iv=incident.getSelectedItemPosition()==1?"vacation":incident.getSelectedItemPosition()==2?"sick_leave":incident.getSelectedItemPosition()==3?"absence":incident.getSelectedItemPosition()==4?"personal":null;JSONObject x=new JSONObject();try{x.put("p_session_token",token);x.put("p_work_date",today());x.put("p_normal",val(normal));x.put("p_extra",val(extra));x.put("p_holiday",val(fest));x.put("p_personal",val(personal));x.put("p_worksite",worksite.getText().toString());x.put("p_incident",iv==null?JSONObject.NULL:iv);x.put("p_notes",notes.getText().toString());x.put("p_employee_id",JSONObject.NULL);}catch(Exception ignored){}save.setEnabled(false);rpc("app_save_entry",x,r->{save.setEnabled(true);if(r.optBoolean("ok"))toast("Guardado y sincronizado");else toast(r.optString("error","No se pudo guardar"));});});
    }
    private EditText numberField(String s){EditText e=field(s);e.setInputType(InputType.TYPE_CLASS_NUMBER|InputType.TYPE_NUMBER_FLAG_DECIMAL);e.setText(s);e.setGravity(Gravity.CENTER);return e;}
    private LinearLayout hourBox(String label,EditText e){LinearLayout x=new LinearLayout(this);x.setOrientation(LinearLayout.VERTICAL);x.setPadding(dp(5),dp(8),dp(5),dp(2));TextView l=text(label,11,MUTED,true);l.setGravity(Gravity.CENTER);x.addView(l);x.addView(e,new LinearLayout.LayoutParams(-1,dp(48)));return x;}
    private double val(EditText e){try{return Double.parseDouble(e.getText().toString().replace(',','.'));}catch(Exception x){return 0;}}
    private String cleanNum(double d){return d==(long)d?String.valueOf((long)d):String.valueOf(d);}

    private void renderMonth(){
        LinearLayout c=card();page.addView(c);LinearLayout h=new LinearLayout(this);h.setGravity(Gravity.CENTER_VERTICAL);Button prev=button("‹",false),next=button("›",false);TextView title=text(monthName(monthCursor),18,WHITE,true);title.setGravity(Gravity.CENTER);h.addView(prev,new LinearLayout.LayoutParams(dp(48),dp(44)));h.addView(title,new LinearLayout.LayoutParams(0,dp(44),1));h.addView(next,new LinearLayout.LayoutParams(dp(48),dp(44)));c.addView(h);LinearLayout list=new LinearLayout(this);list.setOrientation(LinearLayout.VERTICAL);c.addView(list);
        prev.setOnClickListener(v->{monthCursor.add(Calendar.MONTH,-1);renderMonthReplace();});next.setOnClickListener(v->{monthCursor.add(Calendar.MONTH,1);renderMonthReplace();});
        Calendar a=(Calendar)monthCursor.clone();a.set(Calendar.DAY_OF_MONTH,1);Calendar z=(Calendar)a.clone();z.set(Calendar.DAY_OF_MONTH,z.getActualMaximum(Calendar.DAY_OF_MONTH));JSONObject b=new JSONObject();try{b.put("p_session_token",token);b.put("p_start_date",iso(a));b.put("p_end_date",iso(z));b.put("p_employee_id",JSONObject.NULL);}catch(Exception ignored){}list.addView(text("Cargando el mes…",13,MUTED,false));rpc("app_get_entries",b,r->{list.removeAllViews();JSONArray es=r.optJSONArray("entries");if(es==null||es.length()==0){TextView m=text("No hay registros este mes",14,MUTED,false);m.setGravity(Gravity.CENTER);m.setPadding(0,dp(24),0,dp(24));list.addView(m);return;}for(int i=0;i<es.length();i++){JSONObject e=es.optJSONObject(i);LinearLayout row=new LinearLayout(this);row.setOrientation(LinearLayout.VERTICAL);row.setPadding(0,dp(11),0,dp(11));TextView d=text(humanDate(e.optString("date")),14,WHITE,true);row.addView(d);String s="";if(e.optDouble("normal")>0)s+="Normal "+cleanNum(e.optDouble("normal"))+" h   ";if(e.optDouble("extra")>0)s+="Extra "+cleanNum(e.optDouble("extra"))+" h   ";if(e.optDouble("holiday")>0)s+="Festivo "+cleanNum(e.optDouble("holiday"))+" h   ";if(e.optDouble("personal")>0)s+="Personal "+cleanNum(e.optDouble("personal"))+" h   ";String inc=e.optString("incident","");if(inc.equals("vacation"))s+="Vacaciones";if(inc.equals("sick_leave"))s+="Baja / IT";row.addView(text(s.isEmpty()?"Sin horas":s,12,MUTED,false));String w=e.optString("worksite","");if(!w.isEmpty())row.addView(text("Obra: "+w,12,BLUE,false));list.addView(row);View sep=new View(this);sep.setBackgroundColor(Color.rgb(34,34,34));list.addView(sep,new LinearLayout.LayoutParams(-1,dp(1)));}});
    }
    private void renderMonthReplace(){showTab("Mes");}

