    private void renderCompany(){
        LinearLayout c=card();page.addView(c);c.addView(text("EMPRESA",20,WHITE,true));c.addView(text("Resumen y trabajadores",13,MUTED,false));LinearLayout list=new LinearLayout(this);list.setOrientation(LinearLayout.VERTICAL);c.addView(list);list.addView(text("Cargando…",13,MUTED,false));JSONObject b=new JSONObject();try{b.put("p_session_token",token);}catch(Exception ignored){}rpc("admin_list_employees",b,r->{list.removeAllViews();JSONArray es=r.optJSONArray("employees");if(es==null){list.addView(text(r.optString("error","No se pudo cargar"),13,RED,false));return;}for(int i=0;i<es.length();i++){JSONObject e=es.optJSONObject(i);LinearLayout row=new LinearLayout(this);row.setOrientation(LinearLayout.VERTICAL);row.setPadding(0,dp(10),0,dp(10));row.addView(text(e.optString("full_name"),14,WHITE,true));row.addView(text((e.optBoolean("active",true)?"Activo":"Inactivo")+" · "+e.optString("username",""),11,e.optBoolean("active",true)?GREEN:MUTED,false));list.addView(row);}});
    }

    private void rpc(String fn, JSONObject body, Callback cb){post(SUPABASE_URL+"/rest/v1/rpc/"+fn,body,true,cb);}
    private void edge(String path, JSONObject body, Callback cb){post(REGISTRO_URL+path,body,false,cb);}
    private void post(String url,JSONObject body,boolean supabase,Callback cb){
        io.submit(()->{JSONObject out=new JSONObject();HttpURLConnection c=null;try{c=(HttpURLConnection)new URL(url).openConnection();c.setConnectTimeout(15000);c.setReadTimeout(20000);c.setRequestMethod("POST");c.setDoOutput(true);c.setRequestProperty("Content-Type","application/json");if(supabase){c.setRequestProperty("apikey",ANON_KEY);c.setRequestProperty("Authorization","Bearer "+ANON_KEY);}byte[] d=body.toString().getBytes(StandardCharsets.UTF_8);try(OutputStream os=c.getOutputStream()){os.write(d);}int code=c.getResponseCode();InputStream in=code>=200&&code<400?c.getInputStream():c.getErrorStream();String txt=read(in);if(txt==null||txt.trim().isEmpty())out.put("ok",code>=200&&code<300);else{Object parsed=new JSONTokener(txt).nextValue();if(parsed instanceof JSONObject)out=(JSONObject)parsed;else if(parsed instanceof JSONArray){JSONArray a=(JSONArray)parsed;if(a.length()>0&&a.opt(0)instanceof JSONObject)out=a.getJSONObject(0);else out.put("data",a);}}}catch(Exception e){try{out.put("ok",false);out.put("error","Sin conexión: "+e.getMessage());}catch(Exception ignored){}}finally{if(c!=null)c.disconnect();}JSONObject fin=out;ui.post(()->cb.done(fin));});
    }
    private String read(InputStream in)throws IOException{if(in==null)return"";ByteArrayOutputStream b=new ByteArrayOutputStream();byte[] buf=new byte[4096];int n;while((n=in.read(buf))>0)b.write(buf,0,n);return b.toString(StandardCharsets.UTF_8.name());}
    interface Callback{void done(JSONObject r);}
}

