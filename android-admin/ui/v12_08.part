docScope').onchange=renderDocuments;$('docEmployee').onchange=renderDocuments;$('reloadDocs').onclick=renderDocuments;
async function renderWorksites(){$('worksitesList').innerHTML='<div class="loading">Cargando obras…</div>';const r=await api('admin/worksites',{p_session_token:token});if(!r.ok){$('worksitesList').innerHTML='<div class="rowCard error">'+esc(r.error||'Error')+'</div>';return}const items=r.items||[];$('worksitesList').innerHTML=items.map(w=>`<div class="rowCard"><div class="rowTop"><div class="grow"><div class="rowName">${esc(w.code)}</div><div class="rowMeta">${esc(w.name||'')}</div></div><span class="badge ${w.active?'':'off'}">${w.active?'ACTIVA':'INACTIVA'}</span></div></div>`).join('')}
$('addWorksite').onclick=()=>openModal('Añadir obra',`<div class="field"><label>CÓDIGO / NOMBRE CORTO</label><input id="woCode"></div><div class="field"><label>NOMBRE / DESCRIPCIÓN</label><input id="woName"></div><button id="woSave" class="btn" style="width:100%">GUARDAR OBRA</button><div id="woMsg" class="msg"></div>`),document.addEventListener('click',async function onceW(ev){if(ev.target?.id!=='woSave')return;document.removeEventListener('click',onceW);const r=await api('admin/worksite-upsert',{p_session_token:token,p_id:null,p_code:$('woCode').value.trim(),p_name:$('woName').value.trim(),p_active:true});if(!r.ok){setMsg('woMsg',r.error||'No se pudo guardar');return}closeModal();renderWorksites()});
async function renderHolidays(){$('holidaysList').innerHTML='<div class="loading">Cargando festivos…</div>';const y=new Date().getFullYear(),r=await api('admin/holidays',{p_session_token:token,p_year:y});if(!r.ok){$('holidaysList').innerHTML='<div class="rowCard error">'+esc(r.error||'Error')+'</div>';return}const items=r.items||[];$('holidaysList').innerHTML=items.map(h=>`<div class="rowCard"><div class="rowTop"><div class="grow"><div class="rowName">${String(h.date).split('-').reverse().join('/')} · ${esc(h.name)}</div><div class="rowMeta">${h.is_local?'Festivo local':'Festivo general'}</div></div><button class="btn danger small" data-delholiday="${h.date}">Eliminar</button></div></div>`).join('');$$('[data-delholiday]').forEach(b=>b.onclick=async()=>{if(!confirm('¿Eliminar este festivo?'))return;const z=await api('admin/holiday-delete',{p_session_token:token,p_date:b.dataset.delholiday});if(!z.ok)alert(z.error||'No se pudo eliminar');else renderHolidays()})}
$('addHoliday').onclick=()=>openModal('Añadir festivo',`<div class="field"><label>FECHA</label><input id="hdDate" type="date"></div><div class="field"><label>NOMBRE</label><input id="hdName"></div><div class="field"><label><input id="hdLocal" type="checkbox" style="width:auto"> Festivo local</label></div><button id="hdSave" class="btn" style="width:100%">GUARDAR FESTIVO</button><div id="hdMsg" class="msg"></div>`),document.addEventListener('click',async function onceH(ev){if(ev.target?.id!=='hdSave')return;document.removeEventListener('click',onceH);const r=await api('admin/holiday-upsert',{p_session_token:token,p_date:$('hdDate').value,p_name:$('hdName').value.trim(),p_is_local:$('hdLocal').checked});if(!r.ok){setMsg('hdMsg',r.error||'No se pudo guardar');return}closeModal();renderHolidays()});

function refreshActivePage(){showSection(activePage)}
function openDrawer(){$('drawer').classList.add('open');$('drawerShade').classList.add('open')}
function closeDrawer(){$('drawer').classList.remove('open');$('drawerShade').classList.remove('open')}
$('menuBtn').onclick=openDrawer;$('drawerShade').onclick=closeDrawer;

function renderUsers(){
 const list=employees;
 $('usersList').innerHTML=list.map(e=>`<div class="rowCard"><div class="rowTop"><div class="grow"><div class="rowName">${esc(e.full_name)}</div><div class="rowMeta">Usuario: <b>${esc(e.username||'—')}</b></div></div><span class="badge ${e.active?'':'off'}">${e.active?'ACTIVO':'BAJA'}</span></div><div class="toolbar" style="margin-top:10px"><button class="btn small" data-userpin="${e.id}">Cambiar PIN</button><button class="btn ${e.active?'danger':'secondary'} small" data-useractive="${e.id}" data-active="${e.active?'1':'0'}">${e.active?'Desactivar acceso':'Reactivar acceso'}</button></div></div>`).join('');
 $$('[data-userpin]').forEach(b=>b.onclick=()=>resetPin(b.dataset.userpin));
 $$('[data-useractive]').forEach(b=>b.onclick=async()=>{await toggleWorker(b.dataset.useractive,b.dataset.active==='1');renderUsers()})
}

function setupPayroll(){const now=new Date();payrollCursor=new Date(now.getFullYear(),now.getMonth(),1);$('payrollLabel').textContent=''}
function payrollFileFor(employeeId){return payrollFiles.find(x=>x.employee_id===employeeId)||null}
function formatBytes(v){const x=n(v);if(!x)return '';if(x<1024)return x+' B';if(x<1024*1024)return (x/1024).toFixed(0)+' KB';return (x/1024/1024).toFixed(1).replace('.',',')+' MB'}
async function downloadPayroll(id){const z=await api('admin/payroll-download-url',{p_session_token:token,id});if(!z.ok){alert(z.error||'No se pudo abrir la nómina');return}window.location.href=z.url}
async function deletePayroll(id){if(!confirm('¿Eliminar esta nómina?'))return;const z=await api('admin/payroll-delete',{p_session_token:token,id});if(!z.ok){alert(z.error||'No se pudo eliminar');return}renderPayroll()}
function openPayrollUpload(employeeId){const emp=employees.find(e=>e.id===employeeId),old=payrollFileFor(employeeId),y=payrollCursor.getFullYear(),m=payrollCursor.getMonth()+1;if(!emp)return;openModal((old?'Sustituir':'Adjuntar')+' nómina · '+emp.full_name,`<div class="rowCard"><div class="rowName">${esc(emp.full_name)}</div><div class="rowMeta">${payrollCursor.toLocaleDateString('es-ES',{month:'long',year:'numeric'})} · periodo 21 → 20</div>${old?`<div class="payroll-file-name">Actual: ${esc(old.original_name)}</div>`:''}</div><div class="field"><label>NÓMINA · PDF / ARCHIVO</label><input id="payrollFileInput" type="file" accept="application/pdf,image/*"></div><div class="field"><label>NOTAS</label><textarea id="payrollNotes">${esc(old?.notes||'')}</textarea></div><button id="payrollUploadSave" class="btn" style="width:100%">${old?'SUSTITUIR NÓMINA':'GUARDAR NÓMINA'}</button><div id="payrollUploadMsg" class="msg"></div>`);$('payrollUploadSave').onclick=async()=>{const file=$('payrollFileInput').files?.[0];if(!file){setMsg('payrollUploadMsg','Selecciona el archivo de nómina');return}const fd=new FormData();fd.append('p_session_token',token);fd.append('file',file);fd.append('employee_id',employeeId);fd.append('payroll_year',String(