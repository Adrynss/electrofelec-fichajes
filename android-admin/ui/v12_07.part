lass="rowCard"><div class="rowTop"><div class="grow"><div class="rowName">${esc(e.full_name)}</div><div class="rowMeta">${esc(e.username||'')} ${e.dni_nie?'· '+esc(e.dni_nie):''}</div></div><span class="badge ${e.active?'':'off'}">${e.active?'ACTIVO':'BAJA'}</span></div><div class="grid2" style="margin-top:9px"><button class="btn secondary small" data-pin="${e.id}">RESET PIN</button><button class="btn ${e.active?'danger':'secondary'} small" data-toggle="${e.id}" data-active="${e.active?'1':'0'}">${e.active?'DAR DE BAJA':'REACTIVAR'}</button></div></div>`).join('');$$('[data-pin]').forEach(b=>b.onclick=()=>resetPin(b.dataset.pin));$$('[data-toggle]').forEach(b=>b.onclick=()=>toggleWorker(b.dataset.toggle,b.dataset.active==='1'))}
$('workerSearch').oninput=renderWorkers;
$('addWorker').onclick=()=>openModal('Añadir trabajador',`<div class="field"><label>NOMBRE Y APELLIDOS</label><input id="nwName"></div><div class="grid2"><div class="field"><label>USUARIO</label><input id="nwUser" autocapitalize="none"></div><div class="field"><label>PIN INICIAL</label><input id="nwPin" inputmode="numeric" maxlength="6"></div></div><div class="field"><label>DNI / NIE</label><input id="nwDni"></div><div class="grid2"><div class="field"><label>VACACIONES ANUALES</label><input id="nwVac" type="number" value="30"></div><div class="field"><label>PERSONALES (H)</label><input id="nwPers" type="number" value="12"></div></div><button id="nwSave" class="btn" style="width:100%">CREAR TRABAJADOR</button><div id="nwMsg" class="msg"></div>`),document.addEventListener('click',async function once(ev){if(ev.target?.id!=='nwSave')return;document.removeEventListener('click',once);const r=await api('admin/create',{p_session_token:token,p_full_name:$('nwName').value.trim(),p_username:$('nwUser').value.trim(),p_pin:$('nwPin').value.trim(),p_dni_nie:$('nwDni').value.trim()||null,p_vacation_days:n($('nwVac').value||30),p_personal_hours:n($('nwPers').value||12)});if(!r.ok){setMsg('nwMsg',r.error||'No se pudo crear');return}closeModal();await loadEmployees();renderWorkers()});
async function resetPin(id){const e=employees.find(x=>x.id===id),pin=prompt('Nuevo PIN de 6 cifras para '+(e?.full_name||'trabajador')+':');if(pin===null)return;if(!/^[0-9]{6}$/.test(pin)){alert('El PIN debe tener 6 cifras');return}const r=await api('admin/reset-pin',{p_session_token:token,p_profile_id:id,p_new_pin:pin});alert(r.ok?'PIN actualizado':(r.error||'No se pudo actualizar'))}
async function toggleWorker(id,isActive){const e=employees.find(x=>x.id===id);if(!confirm((isActive?'Dar de baja a ':'Reactivar a ')+(e?.full_name||'trabajador')+'?'))return;const r=await api('admin/active',{p_session_token:token,p_profile_id:id,p_active:!isActive});if(!r.ok){alert(r.error||'No se pudo cambiar');return}await loadEmployees();renderWorkers()}
function setupDocEmployees(){const sel=$('docEmployee');const current=sel.value;const list=activeEmployees();sel.innerHTML=list.map(e=>`<option value="${e.id}">${esc(e.full_name)}</option>`).join('');if(current&&list.some(e=>e.id===current))sel.value=current;}
function docStatusLabel(s){return ({pending:'PENDIENTE',expired:'CADUCADO',upcoming:'PRÓXIMO',valid:'VIGENTE'})[s]||String(s||'').toUpperCase()}
function docDate(v){return v?String(v).split('-').reverse().join('/'):'—'}
async function renderDocuments(){setupDocEmployees();$('docsList').innerHTML='<div class="loading">Cargando documentación…</div>';const status=$('docStatus').value||null,scope=$('docScope').value||null,employeeId=scope==='employee'?($('docEmployee').value||activeEmployees()[0]?.id||null):null;$('docEmployeeRow').classList.toggle('hidden',scope!=='employee');if(scope==='employee'&&!employeeId){$('docsList').innerHTML='<div class="rowCard muted">No hay trabajadores activos.</div>';return}const r=await api('admin/documents',{p_session_token:token,p_status:status,p_scope:scope,p_employee_id:employeeId});if(!r.ok){$('docsList').innerHTML='<div class="rowCard error">'+esc(r.error||'Error')+'</div>';return}docItems=r.items||[];const c=docItems.reduce((o,d)=>(o[d.status]=(o[d.status]||0)+1,o),{});$('docCounts').innerHTML=`<div class="docCount"><span>PENDIENTES</span><b>${n(c.pending)}</b></div><div class="docCount"><span>CADUCADOS</span><b class="status-expired">${n(c.expired)}</b></div><div class="docCount"><span>PRÓXIMOS</span><b class="status-upcoming">${n(c.upcoming)}</b></div><div class="docCount"><span>VIGENTES</span><b class="status-valid">${n(c.valid)}</b></div>`;const owner=scope==='company'?'Empresa':scope==='employee'?(employees.find(e=>e.id===employeeId)?.full_name||'Trabajador'):'Empresa + empleados';$('docContext').textContent=(scope==='company'?'Documentación de empresa · 26 tipos':scope==='employee'?'PRL / Empleado · 20 tipos':'Control documental global')+' · '+owner;$('docsList').innerHTML=docItems.map((d,i)=>`<div class="rowCard"><div class="rowTop"><div class="grow"><div class="rowName">${scope?esc(d.document_name):esc(d.owner_name||'Empresa')+' · '+esc(d.document_name)}</div><div class="rowMeta">${esc(d.category||'')}${!scope&&d.scope==='company'?' · EMPRESA':!scope?' · EMPLEADO':''}</div></div><b class="status-${esc(d.status)}">${docStatusLabel(d.status)}</b></div>${d.original_name?`<div class="rowMeta" style="margin-top:7px">📎 ${esc(d.original_name)}</div><div class="rowMeta">Emisión: ${docDate(d.issue_date)} · Caducidad: ${docDate(d.expiry_date)}${d.notes?' · '+esc(d.notes):''}</div><div class="toolbar" style="margin-top:9px"><button class="btn secondary small" data-docdownload="${i}">DESCARGAR</button><button class="btn secondary small" data-docedit="${i}">EDITAR</button><button class="btn secondary small" data-docreplace="${i}">SUSTITUIR</button><button class="btn danger small" data-docdelete="${i}">ELIMINAR</button></div>`:`<div class="rowMeta" style="margin-top:7px">Sin archivo adjunto</div><button class="btn small" style="margin-top:9px" data-docupload="${i}">+ ADJUNTAR</button>`}</div>`).join('')||'<div class="rowCard muted">Sin resultados.</div>';$$('[data-docupload]').forEach(b=>b.onclick=()=>openDocUpload(n(b.dataset.docupload),false));$$('[data-docreplace]').forEach(b=>b.onclick=()=>openDocUpload(n(b.dataset.docreplace),true));$$('[data-docedit]').forEach(b=>b.onclick=()=>openDocEdit(n(b.dataset.docedit)));$$('[data-docdownload]').forEach(b=>b.onclick=()=>downloadDoc(n(b.dataset.docdownload)));$$('[data-docdelete]').forEach(b=>b.onclick=()=>deleteDoc(n(b.dataset.docdelete)))}
$('docStatus').onchange=renderDocuments;$('