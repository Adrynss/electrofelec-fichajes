s="label">Documentos pendientes</div><div class="value">${n(dc.pending)}</div><div class="sub">Sin archivo vigente</div></button>
  <button class="card kpi" data-docstatus="valid"><div class="label">Documentación en regla</div><div class="value good">${n(dc.valid)}</div><div class="sub">Documentos vigentes</div></button>
 </div>
 <div class="grid2" style="margin-top:14px">
  <button class="card kpi" data-docscope="employee"><div class="label">PRL · Empleados</div><div class="value">${emp.length}</div><div class="sub"><span class="bad">${sc(emp,'expired')} cad.</span> · <span class="warn">${sc(emp,'upcoming')} próximos</span> · ${sc(emp,'pending')} pendientes</div></button>
  <button class="card kpi" data-docscope="company"><div class="label">Documentación · Empresa</div><div class="value">${company.length}</div><div class="sub"><span class="bad">${sc(company,'expired')} cad.</span> · <span class="warn">${sc(company,'upcoming')} próximos</span> · ${sc(company,'pending')} pendientes</div></button>
 </div>
 <div class="section-title"><div><h2>Prioridad documental</h2><div class="muted small">Caducados y próximos a caducar</div></div><button class="btn" data-docscope="">Abrir CAE / PRL</button></div>
 <div class="doc-priority">${urgent.length?urgent.map(d=>`<div class="priority-row"><div class="owner">${esc(d.owner_name||'Empresa')}</div><div class="docname">${esc(d.document_name||'Documento')}</div><div class="status-${esc(d.status)}"><b>${docStatusLabel(d.status)}</b><div class="tiny">${d.expiry_date?docDate(d.expiry_date):''}</div></div></div>`).join(''):'<div class="rowCard good">No hay documentos caducados ni próximos a caducar.</div>'}</div>`;
 $$('[data-docstatus]').forEach(b=>b.onclick=()=>{$('docScope').value='';$('docStatus').value=b.dataset.docstatus||'';showSection('Documents')});
 $$('[data-docscope]').forEach(b=>b.onclick=()=>{$('docScope').value=b.dataset.docscope||'';$('docStatus').value='';showSection('Documents')});
}
function setupYears(){const y=new Date().getFullYear();$('vacYear').innerHTML=[y-1,y,y+1].map(v=>`<option value="${v}" ${v===y?'selected':''}>${v}</option>`).join('')}
$('vacYear').onchange=renderVacations;
async function renderVacations(){$('vacList').innerHTML='<div class="loading">Cargando saldos…</div>';const y=n($('vacYear').value||new Date().getFullYear()),r=await api('admin/balances',{p_session_token:token,p_year:y});if(!r.ok){$('vacList').innerHTML='<div class="rowCard error">'+esc(r.error||'Error')+'</div>';return}vacData=r.employees||[];$('vacList').innerHTML=vacData.map(v=>`<button class="rowCard" style="color:inherit;text-align:left;width:100%" data-vacemp="${v.employee_id}"><div class="rowTop"><div class="grow"><div class="rowName">${esc(v.full_name)}</div><div class="rowMeta">Año ${y}</div></div><span class="badge ${v.active?'':'off'}">${v.active?'ACTIVO':'BAJA'}</span></div><div class="vacGrid"><div><span>ANUALES</span><b>${fmt(v.annual_vacation)}</b></div><div><span>USADAS</span><b>${fmt(v.vacation_used)}</b></div><div><span>PAGADAS</span><b style="color:var(--amber)">${fmt(v.vacation_paid)}</b></div><div><span>RESTANTES</span><b style="color:var(--green)">${fmt(v.vacation_remaining)}</b></div><div><span>PERS. ANUAL</span><b>${fmt(v.annual_personal)}</b></div><div><span>PERS. USADAS</span><b>${fmt(v.personal_used)}</b></div><div><span>PERS. REST.</span><b>${fmt(v.personal_remaining)}</b></div><div><span>AJUSTE VC</span><b>${fmt(v.vacation_adjustment)}</b></div></div></button>`).join('');$$('[data-vacemp]').forEach(b=>b.onclick=()=>openVacation(b.dataset.vacemp,y))}
async function openVacation(empId,year){const v=vacData.find(x=>x.employee_id===empId);openModal(v?.full_name||'Vacaciones','<div class="loading">Cargando movimientos…</div>');const r=await api('admin/balance-list',{p_session_token:token,p_employee_id:empId,p_year:year});const items=r.ok?(r.items||[]):[];$('modalBody').innerHTML=`<div class="vacGrid"><div><span>USADAS</span><b>${fmt(v.vacation_used)}</b></div><div><span>PAGADAS</span><b style="color:var(--amber)">${fmt(v.vacation_paid)}</b></div><div><span>RESTANTES</span><b style="color:var(--green)">${fmt(v.vacation_remaining)}</b></div><div><span>ANUALES</span><b>${fmt(v.annual_vacation)}</b></div></div><div class="card" style="margin-top:12px"><div class="title" style="font-size:15px">Añadir vacaciones pagadas</div><div class="grid2"><div class="field"><label>DÍAS PAGADOS</label><input id="paidDays" type="number" min="0.5" step="0.5" placeholder="Ej. 5"></div><div class="field"><label>FECHA</label><input id="paidDate" type="date" value="${iso(new Date())}"></div></div><div class="field"><label>MOTIVO</label><input id="paidReason" placeholder="Ej. Vacaciones abonadas en nómina"></div><button id="addPaid" class="btn" style="width:100%">GUARDAR DÍAS PAGADOS</button><div id="paidMsg" class="msg"></div></div><div class="hist"><div class="title" style="font-size:15px">Movimientos registrados</div>${items.length?items.map(it=>`<div class="histItem"><div class="grow"><b>${it.kind==='vacation_paid'?fmt(it.amount)+' días pagados':esc(it.kind)+' '+fmt(it.amount)}</b><div class="tiny">${String(it.adjustment_date||'').split('-').reverse().join('/')} · ${esc(it.reason||'')}</div></div><button class="btn danger small" data-deladj="${it.id}">Eliminar</button></div>`).join(''):'<div class="muted">Sin movimientos.</div>'}</div>`;$('addPaid').onclick=async()=>{const days=n($('paidDays').value),reason=$('paidReason').value.trim();if(days<=0){setMsg('paidMsg','Indica los días pagados');return}if(!reason){setMsg('paidMsg','Indica un motivo');return}const z=await api('admin/vacation-paid',{p_session_token:token,p_employee_id:empId,p_year:year,p_days:days,p_reason:reason,p_adjustment_date:$('paidDate').value});if(!z.ok){setMsg('paidMsg',z.error||'No se pudo guardar');return}setMsg('paidMsg','Guardado',true);setTimeout(async()=>{closeModal();await renderVacations();openVacation(empId,year)},350)};$$('[data-deladj]').forEach(b=>b.onclick=async()=>{if(!confirm('¿Eliminar este movimiento?'))return;const z=await api('admin/balance-delete',{p_session_token:token,p_id:b.dataset.deladj});if(!z.ok){alert(z.error||'No se pudo eliminar');return}closeModal();await renderVacations();openVacation(empId,year)})}
function renderWorkers(){const q=$('workerSearch').value.trim().toLowerCase(),list=employees.filter(e=>!q||String(e.full_name).toLowerCase().includes(q)||String(e.username||'').toLowerCase().includes(q));$('workersList').innerHTML=list.map(e=>`<div c