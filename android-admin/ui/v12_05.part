   return String(a.expiry_date||'9999-12-31').localeCompare(String(b.expiry_date||'9999-12-31'))
 }).slice(0,12);
 const emp=items.filter(d=>d.scope==='employee'),company=items.filter(d=>d.scope==='company');
 const sc=(arr,status)=>arr.filter(x=>x.status===status).length;
 $('dashContent').innerHTML=`
 <div class="card hero"><div><h2><span class="brand-top-logo">${document.querySelector('.logo-svg')?.outerHTML||''}</span>Control CAE / PRL</h2><p>Estado documental de Electrofelec · ${esc(me.full_name)}</p></div><div class="sync-pill">● SUPABASE · ONLINE</div></div>
 <div class="kpis">
  <button class="card kpi" data-docstatus="expired"><div class="label">Documentos caducados</div><div class="value bad">${n(dc.expired)}</div><div class="sub">Requieren actuación</div></button>
  <button class="card kpi" data-docstatus="upcoming"><div class="label">Próximos a caducar</div><div class="value warn">${n(dc.upcoming)}</div><div class="sub">Próximos 30 días</div></button>
  <button class="card kpi" data-docstatus="pending"><div clas