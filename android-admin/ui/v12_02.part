c1710;border:1px solid #213126;border-radius:11px;padding:12px;margin-bottom:8px}.rowTop{display:flex;align-items:center;gap:8px}.rowName{font-weight:800}.rowMeta{font-size:12px;color:var(--muted);margin-top:5px}.badge{display:inline-flex;padding:4px 8px;border-radius:999px;background:#17271a;border:1px solid #29432e;font-size:11px;color:#7cff68}.badge.off{color:#ff7780;border-color:#542029;background:#2b1115}.stats,.docCounts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat,.docCount{padding:12px;border-radius:11px;border:1px solid #213126;background:#0c1710;text-align:center}.stat span,.docCount span{display:block;font-size:10px;color:var(--muted)}.stat b,.docCount b{font-size:20px}.vacGrid{display:grid;grid-template-columns:repeat(8,1fr);gap:6px;margin-top:10px}.vacGrid div{background:#0e1911;border:1px solid #1f2d23;border-radius:9px;padding:8px;text-align:center}.vacGrid span{display:block;color:var(--muted);font-size:9px}.vacGrid b{font-size:15px}.monthNav{display:grid;grid-template-columns:46px 1fr 46px;gap:10px;align-items:center}.monthNav .lab{text-align:center;font-weight:800;text-transform:capitalize}.arrow{height:40px;border:1px solid #2a3a2f;background:#132219;color:#fff;border-radius:9px;font-size:22px}.period{margin-top:8px;color:var(--muted);font-size:12px;text-align:center}.hours-shell{border:1px solid var(--line);border-radius:12px;overflow:auto;background:#09120b;max-height:72vh}.hours-grid{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%}.hours-grid th,.hours-grid td{padding:0;border-right:1px solid #1b2920;border-bottom:1px solid #1b2920;text-align:center;height:68px}.hours-grid thead th{position:sticky;top:0;z-index:5;background:#122018;padding:6px 5px;min-width:76px;height:52px}.hours-grid .worker-col{position:sticky;left:0;z-index:4;background:#0f1c12!important;text-align:left!important;min-width:190px;width:190px;max-width:190px;padding:7px 10px!important;white-space:normal;line-height:1.2}.hours-grid thead .worker-col{z-index:8}.hours-grid .total-col{min-width:62px;background:#0e1911}.hours-grid td.sab{background:#0e1520}.hours-grid td.dom{background:#17121b}.hours-grid th.sab{background:#152033}.hours-grid th.dom{background:#251b2a}.day-cell{cursor:pointer;min-width:76px;max-width:76px;padding:3px!important}.cell-hours{font-size:18px;font-weight:800;line-height:23px;min-height:23px}.code-v{color:var(--green)}.code-b{color:var(--red)}.code-f{color:var(--amber)}.code-p{color:var(--purple)}.work-mini{font-size:9px;color:#b9e7bd;line-height:11px;height:24px;overflow:hidden;white-space:normal;overflow-wrap:anywhere;margin-top:2px}.hours-legend{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:10px}.search{width:100%;margin-bottom:10px}.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:flex-end;justify-content:center;z-index:100;padding-top:30px}.sheet{width:min(760px,100%);max-height:94vh;overflow:auto;background:#0e1911;border:1px solid #2d4132;border-radius:16px 16px 0 0;padding:18px 18px calc(18px + env(safe-area-inset-bottom));box-shadow:0 30px 90px rgba(0,0,0,.55)}.sheetHead{display:flex;align-items:center;gap:10px}.sheetHead h3{margin:0;flex:1}.close{width:42px;height:42px;border-radius:10px;border:1px solid #2a3a2f;background:#132219;color:#fff;font-size:20px}.drawer-shade{display:none}.login-screen{min-height:100vh;display:grid;place-items:center;padding:20px}.login-box{width:min(440px,100%)}.login-brand{display:flex;align-items:center;gap:14px;margin-bottom:20px}.login-brand .logo-svg{width:76px;height:76px}.login-card{background:linear-gradient(180deg,#122215,#0b160e);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--shadow)}
@media(max-width:900px){.app{display:block}.sidebar{position:fixed;left:-270px;top:0;bottom:0;width:250px;height:auto;transition:left .18s ease;z-index:90}.sidebar.open{left:0}.drawer-shade{position:fixed;inset:0;background:#0009;z-index:80;display:none}.drawer-shade.open{display:block}.menu-btn{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:1px solid #2a3a2f;background:#132219;color:#fff;border-radius:10px;font-size:22px}.topbar{padding:10px 12px}.content{padding:14px 12px 30px}.kpis{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}.grid3{grid-template-columns:1fr}.vacGrid{grid-template-columns:repeat(4,1fr)}.stats,.docCounts{grid-template-columns:1fr 1fr}.hero{align-items:flex-start;flex-direction:column}.sync-pill{font-size:9px}.hours-shell{max-height:70vh}.hours-grid .worker-col{min-width:155px;width:155px;max-width:155px}.hours-grid thead th,.day-cell{min-width:72px;max-width:72px}.topbar h1{font-size:18px}}
@media(max-width:420px){.kpis{grid-template-columns:1fr 1fr;gap:8px}.card{padding:13px}.kpi .value{font-size:22px}.vacGrid{grid-template-columns:repeat(4,1fr)}.sync-pill{display:none}.hours-grid .worker-col{min-width:145px;width:145px;max-width:145px}.hours-grid thead th,.day-cell{min-width:68px;max-width:68px}}
</style></head><body>
<div id="loginView" class="login-screen">
 <div class="login-box"><div class="login-brand"><svg class="logo-svg" viewBox="0 0 512 483" aria-label="Electrofelec"><defs><linearGradient id="g" x1="55" y1="440" x2="455" y2="45" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#005d3e"/><stop offset="0.48" stop-color="#13ad28"/><stop offset="1" stop-color="#8be900"/></linearGradient></defs><path d="M345 44 L334 74 L397 120 L434 180 L445 227 L445 265 L435 306 L402 360 L357 398 L294 423 L222 422 L199 452 L274 460 L348 441 L392 415 L423 387 L465 320 L476 278 L478 240 L459 160 L411 90 Z" fill="url(#g)"/><path d="M310 31 L274 25 L229 27 L153 54 L92 105 L52 173 L42 210 L39 262 L54 327 L89 383 L125 416 L168 440 L182 409 L153 394 L120 366 L93 329 L78 293 L72 231 L84 178 L115 126 L163 85 L227 60 L289 60 Z" fill="url(#g)"/><path d="M346 3 L140 275 L251 277 L162 479 L382 207 L274 206 Z" fill="url(#g)"/></svg><div><b style="font-size:22px">ELECTROFELEC</b><div class="muted">Gestión interna · Admin móvil</div></div></div>
 <div class="login-card"><div class="field"><label>USUARIO</label><input id="loginUser" autocomplete="username" autocapitalize="none"></div><div class="field"><label>PIN · 6 CIFRAS</label><input id="loginPin" type="password" maxlength="6" inputmode="numeric"></div><button id="loginBtn" class="btn" style="width:100%;margin-top:6px">ENTRAR</button><div id="loginMsg" class=