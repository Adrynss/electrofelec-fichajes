<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no"><meta name="theme-color" content="#071009"><title>Electrofelec Admin</title><style>
:root{--bg:#071009;--panel:#0d1810;--panel2:#111f14;--line:#223127;--text:#e8f2ea;--muted:#91a398;--green:#5ee635;--green2:#8ad81a;--red:#ff5c68;--amber:#f1bd4b;--purple:#b57cff;--blue:#63a9ff;--shadow:0 18px 45px rgba(0,0,0,.28)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;background:radial-gradient(circle at 10% 0,#123316 0,transparent 30%),var(--bg);color:var(--text);font-family:Inter,"Segoe UI",Arial,sans-serif}body{min-height:100%;padding-top:env(safe-area-inset-top)}button,input,select,textarea{font:inherit}.hidden{display:none!important}.bad{color:var(--red)!important}.warn{color:var(--amber)!important}.good{color:var(--green)!important}.muted{color:var(--muted)}.small,.tiny{font-size:11px}.app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{position:sticky;top:0;height:100vh;background:rgba(6,13,8,.97);border-right:1px solid var(--line);padding:22px 14px;display:flex;flex-direction:column;z-index:40}.brand{display:flex;gap:12px;align-items:center;padding:2px 8px 22px}.brand-mark{width:58px;height:58px;border-radius:18px;background:linear-gradient(145deg,#0f2716,#08120b);border:1px solid #284330;display:grid;place-items:center;box-shadow:inset 0 0 0 1px #ffffff08,0 10px 26px #0007;flex:none}.logo-svg{width:45px;height:43px;object-fit:contain;display:block}.brand b{font-size:17px;letter-spacing:.55px}.brand small{display:block;color:#8fa699;margin-top:4px;font-size:11px;letter-spacing:.25px}.payroll-doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}.payroll-doc{background:linear-gradient(180deg,#101f13,#0a160d);border:1px solid var(--line);border-radius:13px;padding:14px;min-width:0}.payroll-doc.has-file{border-color:#2d5933}.payroll-doc.missing{border-color:#473c25}.payroll-file-name{font-size:12px;color:#b8c8bc;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.payroll-state{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:5px 8px;font-size:10px;font-weight:800;margin-top:7px}.payroll-state.ok{background:#112a17;color:#78ec61;border:1px solid #285531}.payroll-state.pending{background:#2b2414;color:#f1c867;border:1px solid #514426}.doc-priority{display:grid;gap:8px}.priority-row{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1.4fr) auto;gap:10px;align-items:center;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:#0b150d}.priority-row .owner{font-weight:700;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.priority-row .docname{min-width:0;color:#a8b7ac;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.brand-top-logo{display:inline-grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#0e2113;border:1px solid #294431;margin-right:10px;vertical-align:middle}.brand-top-logo svg{width:35px;height:34px}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:#b7c6bb;text-align:left;padding:11px 12px;border-radius:10px;cursor:pointer}.nav button.active{background:#132219;color:white;box-shadow:inset 3px 0 var(--green)}.nav button span{margin-right:7px}.sidebar .foot{margin-top:auto;padding:10px 8px;color:#77877c;font-size:12px}.main{min-width:0}.topbar{position:sticky;top:0;z-index:30;backdrop-filter:blur(16px);background:rgba(7,16,9,.9);border-bottom:1px solid var(--line);padding:14px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px}.topbar h1{font-size:20px;margin:0}.topbar .actions{display:flex;gap:8px;align-items:center}.menu-btn{display:none}.sync-pill{border:1px solid #28512d;background:#102615;color:#77ee5f;border-radius:999px;padding:8px 11px;font-size:11px;font-weight:800;white-space:nowrap}.content{padding:24px;max-width:none;width:100%}.section{display:none}.section.active{display:block}.card{background:linear-gradient(180deg,rgba(18,34,21,.96),rgba(11,22,14,.96));border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:var(--shadow);margin-bottom:14px}.kpis{display:grid;grid-template-columns:repeat(4,minmax(170px,1fr));gap:14px}.kpi{display:block;width:100%;text-align:left;color:inherit}.kpi.label{}.kpi .label{color:var(--muted);font-size:13px}.kpi .value{font-size:26px;font-weight:750;margin-top:8px}.kpi .sub{font-size:12px;color:#6f8175;margin-top:6px}.hero{display:flex;align-items:center;justify-content:space-between;gap:20px}.hero h2{font-size:25px;margin:0 0 6px}.hero p{color:var(--muted);margin:0}.section-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:24px 0 10px}.section-title h2{font-size:16px;margin:0}.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.grow{flex:1}.btn{border:1px solid #2a3a2f;background:#132219;color:var(--text);border-radius:9px;padding:9px 12px;cursor:pointer;text-decoration:none}.btn.primary,.btn:not(.danger):not(.ghost):not(.secondary){background:linear-gradient(135deg,#2ba92f,#76d918);border-color:#70d21a;color:#061108;font-weight:750}.btn.secondary{background:#132219;color:var(--text)}.btn.danger{background:#2b1115;border-color:#542029;color:#ffb7bd}.btn.small{padding:7px 9px;font-size:11px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;background:#0b150d}table{width:100%;border-collapse:collapse;min-width:720px}th,td{padding:10px 11px;border-bottom:1px solid #1b2920;text-align:left;font-size:13px;white-space:nowrap}th{position:sticky;top:0;background:#122018;color:#aabeaf;font-size:11px;text-transform:uppercase;letter-spacing:.5px;z-index:1}.field{margin:10px 0}.field label{font-size:12px;color:#9fb0a4;display:block;margin-bottom:5px}.field input,.field select,.field textarea,select,input,textarea{background:#0b150d;border:1px solid #2a3a2f;color:white;border-radius:9px;padding:10px 11px;outline:none;width:100%}.field textarea{min-height:82px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.notice{border:1px solid #2b4130;background:#102015;padding:12px 14px;border-radius:10px;color:#abc0af;font-size:13px}.loading,.empty{text-align:center;color:#718178;padding:30px}.rowCard{display:block;width:100%;text-align:left;color:inherit;background:#0